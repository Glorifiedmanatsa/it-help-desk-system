# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000

# Local Docker Postgres (npm run db:up). For Render/Railway external URLs append ?sslmode=require
DATABASE_URL="postgresql://helpdesk:helpdesk@localhost:5433/helpdesk?schema=public"

# Use a long random string in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Frontend origin(s) allowed by CORS, comma-separated. The first one is used for links in emails.
CLIENT_URL=http://localhost:5173

# Attachments are stored here, outside any web root. On Render, point this at a persistent disk mount.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Email. Leave SMTP_HOST empty in development to print emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IT Help Desk <helpdesk@example.com>"
